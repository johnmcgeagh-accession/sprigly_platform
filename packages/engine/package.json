{
  "name": "@sprigly/engine",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./touch-schedule": {
      "import": "./dist/touch-schedule.js",
      "types": "./dist/touch-schedule.d.ts"
    },
    "./email-render": {
      "import": "./dist/email-render.js",
      "types": "./dist/email-render.d.ts"
    },
    "./base-questions": {
      "import": "./dist/base-questions.js",
      "types": "./dist/base-questions.d.ts"
    },
    "./intake-completeness": {
      "import": "./dist/intake-completeness.js",
      "types": "./dist/intake-completeness.d.ts"
    },
    "./generation-recovery": {
      "import": "./dist/generation-recovery.js",
      "types": "./dist/generation-recovery.d.ts"
    },
    "./ai-change-cap": {
      "import": "./dist/ai-change-cap.js",
      "types": "./dist/ai-change-cap.d.ts"
    },
    "./contrast": {
      "import": "./dist/contrast.js",
      "types": "./dist/contrast.d.ts"
    },
    "./caption-overlap": {
      "import": "./dist/caption-overlap.js",
      "types": "./dist/caption-overlap.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "type-check": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@sprigly/audit": "workspace:*",
    "@sprigly/db": "workspace:*",
    "@sprigly/prompts": "workspace:*",
    "drizzle-orm": "^0.30.0",
