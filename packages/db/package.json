{
  "name": "@sprigly/db",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./e2e-draft-fixture": {
      "import": "./dist/e2e-draft-fixture.js",
      "types": "./dist/e2e-draft-fixture.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "type-check": "tsc --noEmit",
    "generate": "drizzle-kit generate:pg",
    "migrate": "tsx --env-file ../../.env.local src/migrate.ts",
    "migrate:prod": "tsx src/migrate.ts",
    "fix-jsonb": "tsx src/fix-jsonb-encoding.ts",
    "seed": "tsx src/seed.ts"
  },
  "dependencies": {
    "@sprigly/embedding-client": "workspace:*",
    "drizzle-orm": "^0.30.0",
    "postgres": "^3.4.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "typescript": "*",
    "drizzle-kit": "^0.20.0",
    "tsx": "^4.0.0",
    "vitest": "^1.6.0"
  }
}
