{
  "name": "@sprigly/worker",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "sh -c 'set -a && . ../../.env.local && set +a && tsx watch src/index.ts'",
    "start": "node dist/index.js",
    "type-check": "tsc --noEmit",
    "catalogue-refresh": "sh -c 'set -a && . ../../.env.local && set +a && tsx src/catalogue/catalogue-refresh-cli.ts \"$@\"' --",
    "setup-gmail": "tsx --env-file ../../.env.local src/setup-gmail-oauth.ts",
    "setup-drive": "tsx --env-file ../../.env.local src/setup-drive-oauth.ts",
    "verify-drive": "sh -c 'set -a && . ../../.env.local && set +a && tsx src/verify-drive-token.ts \"$@\"' --",
    "revoke-drive": "tsx --env-file ../../.env.local src/revoke-drive-oauth.ts",
    "verify-drive-clientedit": "sh -c 'set -a && . ../../.env.local && set +a && tsx src/verify-drive-clientedit.ts \"$@\"' --",
    "gate3-seed-xlsx": "sh -c 'set -a && . ../../.env.local && set +a && tsx src/gate3-seed-xlsx.ts \"$@\"' --",
    "drive-upload": "sh -c 'set -a && . ../../.env.local && set +a && tsx src/drive-upload.ts \"$@\"' --",
    "reenqueue-voice": "sh -c 'set -a && . ../../.env.local && set +a && tsx src/reenqueue-voice.ts \"$@\"' --",
    "seed-voice": "sh -c 'set -a && . ../../.env.local && set +a && tsx src/seed-voice.ts \"$@\"' --",
    "seed-cycle-config": "sh -c 'set -a && . ../../.env.local && set +a && tsx src/content-cycles/seed-cycle-config.ts \"$@\"' --",
    "merge-voice": "sh -c 'set -a && . ../../.env.local && set +a && tsx src/merge-voice.ts'",
    "revert-voice-merge": "sh -c 'set -a && . ../../.env.local && set +a && tsx src/revert-voice-merge.ts \"$@\"' --",
    "probe-lean-line": "sh -c 'set -a && . ../../.env.local && set +a && tsx src/probe-lean-line.ts'",
    "ig-trawl": "sh -c 'set -a && . ../../.env.local && set +a && tsx src/ig-trawl.ts \"$@\"' --",
    "competitor-gather": "sh -c 'set -a && . ../../.env.local && set +a && tsx src/competitor-gather-cli.ts \"$@\"' --",
    "patch-calendar-config": "sh -c 'set -a && . ../../.env.local && set +a && tsx src/patch-calendar-config.ts \"$@\"' --",
    "send-request-email": "sh -c 'set -a && . ../../.env.local && set +a && tsx src/send-request-email.ts \"$@\"' --",
    "reset-cycle": "sh -c 'set -a && . ../../.env.local && set +a && tsx src/reset-cycle.ts \"$@\"' --",
    "extract-voice-cycle": "sh -c 'set -a && . ../../.env.local && set +a && tsx src/extract-voice-cycle.ts \"$@\"' --",
    "approve-voice-cycle": "sh -c 'set -a && . ../../.env.local && set +a && tsx src/approve-voice-cycle.ts \"$@\"' --",
    "backfill-emails": "tsx --env-file ../../.env.local src/backfill-connection-emails.ts",
    "eval:bedrock":  "sh -c 'set -a && . ../../.env.local && set +a && tsx scripts/eval-bedrock.ts'",
    "eval:harness":           "sh -c 'set -a && . ../../.env.local && set +a && tsx scripts/eval-harness.ts'",
    "eval:harness:anthropic": "sh -c 'set -a && . ../../.env.local && set +a && tsx scripts/eval-harness.ts anthropic'",
    "eval:harness:bedrock":   "sh -c 'set -a && . ../../.env.local && set +a && tsx scripts/eval-harness.ts bedrock'",
    "seed:knowledge":         "sh -c 'set -a && . ../../.env.local && set +a && tsx scripts/seed-knowledge.ts \"$@\"' --",
    "archive:knowledge":      "sh -c 'set -a && . ../../.env.local && set +a && tsx scripts/archive-knowledge.ts \"$@\"' --",
    "test": "vitest run"
  },
  "dependencies": {
    "pino": "^9.0.0",
    "bullmq": "^5.0.0",
    "drizzle-orm": "^0.30.0",
    "zod": "^3.22.0",
    "googleapis": "^144.0.0",
    "@sprigly/db": "workspace:*",
    "@sprigly/embedding-client": "workspace:*",
    "@sprigly/engine": "workspace:*",
    "@sprigly/knowledge": "workspace:*",
    "@sprigly/sources": "workspace:*",
    "@sprigly/workflows": "workspace:*",
    "@sprigly/destinations": "workspace:*",
    "@sprigly/audit": "workspace:*",
    "@sprigly/model-client": "workspace:*",
    "@sprigly/oauth-tokens": "workspace:*",
    "@sprigly/prompts": "workspace:*",
    "@sprigly/web-search": "workspace:*"
  },
  "devDependencies": {
    "typescript": "*",
    "@types/node": "*",
    "tsx": "^4.0.0",
    "vitest": "^1.6.0"
  }
}
