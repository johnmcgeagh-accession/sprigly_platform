{
  "$schema": "https://schema.railpack.com",
  "provider": "node",
  "packages": {
    "node": "22",
    "pnpm": "10.32.1"
  },
  "steps": {
    "install": {
      "inputs": [
        { "include": ["."] }
      ],
      "commands": [
        "ls -la",
        "pnpm install --frozen-lockfile"
      ]
    },
    "build": {
      "inputs": [
        { "step": "install" },
        { "include": ["."] }
      ],
      "commands": [
        "pnpm --filter @sprigly/worker... build"
      ]
    }
  },
  "deploy": {
    "startCommand": "pnpm --filter @sprigly/worker start",
    "inputs": [
      { "step": "build" },
      { "include": ["."] }
    ]
  }
}