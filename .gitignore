.paul

# dependencies / build artifacts — bare patterns match at ANY depth, so they
# cover the lifted workspace (engine/, admin/, packages/*/) not just one level.
node_modules/
dist/
.next/
.turbo/
*.log

# env files — bare patterns ALSO ignore the workspace-root .env.local (the real
# secret file lifted here in Stage 4). .env.example is NOT matched and stays tracked.
*.env
.env.local
.env.*.local

# os
.DS_Store

# worker eval output (was engine/apps/worker/eval-results; worker is now engine/)
engine/eval-results/

# TypeScript incremental build cache (regenerated by tsc; never commit)
*.tsbuildinfo

# macOS/cloud sync duplicates ("foo 2.ts", "bar 3.json", "baz 4"). The " <digit>"
# before the extension (or at end of name) is the conflict-copy shape; real
# filenames have no space-then-digit there, so these rules don't match them.
* [0-9].*
* [0-9]

.vercel
.env*
.env.prod
.bkup.env.local

# Disposable local test DB — schema dump baseline (never commit; may contain schema only)
.test-db/
