{
  "name": "sprigly",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "test": "turbo test",
    "type-check": "turbo type-check",
    "db:generate": "pnpm --filter @sprigly/db generate",
    "db:migrate": "pnpm --filter @sprigly/db migrate",
    "db:seed": "pnpm --filter @sprigly/db seed",
    "new-workflow": "tsx scripts/new-workflow.ts"
  },
  "devDependencies": {
    "turbo": "^2.0.0",
    "typescript": "^5.4.0",
    "@types/node": "^20.0.0",
    "tsx": "^4.7.0"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "^18.3.0",
      "@types/react-dom": "^18.3.0"
    }
  }
}

