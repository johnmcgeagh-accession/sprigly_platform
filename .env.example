# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/sprigly

# ── Auth (Clerk) ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# ── Model Provider ─────────────────────────────────────────────────────────────
# "anthropic" for local dev, "bedrock" for production
MODEL_PROVIDER=anthropic

# Anthropic (dev)
ANTHROPIC_API_KEY=

# AWS Bedrock (prod)
# Region is shared across all AWS services
AWS_REGION=eu-west-2
# Dedicated IAM user for Bedrock (AI model calls only).
# Omit both if running on an IAM role (e.g. Railway/ECS with an attached policy).
# Create user: AWS Console → IAM → Users → Create user → attach AmazonBedrockFullAccess
BEDROCK_AWS_ACCESS_KEY_ID=
BEDROCK_AWS_SECRET_ACCESS_KEY=
# Cross-region inference profile IDs — find at: AWS Console → Amazon Bedrock → Model access → Cross-region inference
BEDROCK_MODEL_ID_HAIKU=eu.anthropic.claude-haiku-3-5-20251001-v1:0
BEDROCK_MODEL_ID_SONNET=eu.anthropic.claude-sonnet-4-5-20251001-v1:0
BEDROCK_MODEL_ID_OPUS=eu.anthropic.claude-opus-4-7-20250514-v1:0

# ── Encryption ─────────────────────────────────────────────────────────────────
# KMS master key ARN (prod)
AWS_KMS_KEY_ID=
# Dedicated IAM user for KMS (token encryption only).
# Omit both if running on an IAM role with the KMS policy attached.
# Create user: AWS Console → IAM → Users → Create user → attach AWSKeyManagementServicePowerUser
KMS_AWS_ACCESS_KEY_ID=
KMS_AWS_SECRET_ACCESS_KEY=
# Local dev fallback when AWS_KMS_KEY_ID is not set (must be 32 bytes when base64-decoded)
LOCAL_DEV_ENCRYPTION_KEY=change-me-32-chars-minimum-please!!

# ── Web Search (Tavily) ────────────────────────────────────────────────────────
# Get a key at https://app.tavily.com — 1,000 free searches/month, $0.04/search after.
TAVILY_API_KEY=tvly-

# ── Redis / BullMQ ─────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Base URLs (two distinct origins — do NOT conflate) ─────────────────────────
# APP_BASE_URL = the CLIENT app (app.sprigly.co.uk). Mints /p/<token> client
#   links (Copy client link + the delivery email). Boot REJECTS an admin.* host.
# ADMIN_BASE_URL = the ADMIN app (admin.sprigly.co.uk). Mints the triage digest
#   /review/<token> link, whose route lives in admin/. Defaults to the admin
#   origin if unset.
APP_BASE_URL=https://app.sprigly.co.uk
ADMIN_BASE_URL=https://admin.sprigly.co.uk

# ── Gmail OAuth ────────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3100/api/oauth/gmail/callback

# ── Seed values ────────────────────────────────────────────────────────────────
# Generate once with: node -e "console.log(require('crypto').randomUUID())"
SPRIGLY_CLIENT_ID=
ADMIN_USER_EMAIL=john@sprigly.co.uk
