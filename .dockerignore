# Docker build context = the WORKSPACE ROOT (dev/). pnpm install runs inside the
# container and populates node_modules fresh. Docker does not match nested paths
# without **, so use **/ to cover engine/, admin/, packages/*/ at any depth.
#
# Critically, this KEEPS every package.json, pnpm-lock.yaml and pnpm-workspace.yaml
# (not matched below) so `pnpm install --frozen-lockfile` still resolves the workspace.
**/node_modules
**/dist
**/.next
**/.turbo
**/*.log
.git/

# Never bake env files into the image — Railway injects env at runtime.
**/.env
**/.env.*

# The marketing site is a separate npm project; the worker image does not need it.
site/
